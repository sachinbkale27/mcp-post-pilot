# OpenAI (used by the LangGraph agent via langchain-openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-11-20

# LangSmith tracing (optional; set LANGSMITH_TRACING=false to turn off)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mcp-blog-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# MCP server the agent connects to
MCP_SERVER_URL=http://127.0.0.1:8101/mcp

# Usage analytics page (#admin): sign-in, as Image Label's admin secret. Without both, the page is off.
# ADMIN_USERS={"username": "you", "password": "a long password"}
# SESSION_SECRET=   # signs sign-in sessions; at least 32 characters: openssl rand -hex 32
# ANALYTICS_BACKEND=memory   # dynamodb on AWS (with ANALYTICS_TABLE)
